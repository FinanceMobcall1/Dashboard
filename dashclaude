<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Dashboard | Mobcall</title>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --primary: #0f172a;
            --primary-light: #1e293b;
            --accent: #3b82f6;
            --accent-dark: #1e40af;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #06b6d4;
            --bg: #f0f4f8;
            --card-bg: #ffffff;
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --border: #e2e8f0;
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: linear-gradient(135deg, #f0f4f8 0%, #e0e7ff 100%);
            font-family: 'Inter', sans-serif;
            color: var(--text-primary);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ===== HEADER ===== */
        .header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            padding: 40px;
            border-radius: 20px;
            margin-bottom: 40px;
            box-shadow: var(--shadow-xl);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: rgba(59, 130, 246, 0.1);
            border-radius: 50%;
        }

        .header-content {
            position: relative;
            z-index: 1;
        }

        .header-tag {
            display: inline-block;
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .header h1 {
            font-family: 'Poppins', sans-serif;
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .header p {
            font-size: 14px;
            opacity: 0.9;
            color: #cbd5e1;
        }

        .header-controls {
            display: flex;
            gap: 15px;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        .select-period {
            padding: 12px 16px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.1);
            color: white;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .select-period:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .select-period option {
            background: var(--primary);
            color: white;
        }

        .btn-refresh {
            background: var(--accent);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .btn-refresh:hover {
            background: var(--accent-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(59, 130, 246, 0.3);
        }

        .btn-refresh:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .timestamp {
            font-size: 12px;
            color: #cbd5e1;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* ===== GRID KPIs ===== */
        .grid-kpis {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .kpi-card {
            background: var(--card-bg);
            padding: 28px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            position: relative;
            overflow: hidden;
            border-left: 5px solid var(--accent);
            transition: all 0.3s ease;
        }

        .kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

        .kpi-card.success {
            border-left-color: var(--success);
        }

        .kpi-card.danger {
            border-left-color: var(--danger);
        }

        .kpi-card.warning {
            border-left-color: var(--warning);
        }

        .kpi-card.info {
            border-left-color: var(--info);
        }

        .kpi-icon {
            position: absolute;
            right: 20px;
            top: 20px;
            font-size: 32px;
            opacity: 0.1;
        }

        .kpi-label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
        }

        .kpi-value {
            display: block;
            font-size: 28px;
            font-weight: 800;
            color: var(--text-primary);
            font-family: 'Poppins', sans-serif;
            margin-bottom: 8px;
        }

        .kpi-change {
            font-size: 12px;
            color: var(--text-secondary);
        }

        .kpi-change.positive {
            color: var(--success);
        }

        .kpi-change.negative {
            color: var(--danger);
        }

        /* ===== HEALTH INDICATOR ===== */
        .health-section {
            background: var(--card-bg);
            padding: 28px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            margin-bottom: 40px;
        }

        .health-title {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .health-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .health-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 16px;
            background: #f8fafc;
            border-radius: 12px;
            border-left: 4px solid;
        }

        .health-item.green {
            border-left-color: var(--success);
            background: #ecfdf5;
        }

        .health-item.yellow {
            border-left-color: var(--warning);
            background: #fffbeb;
        }

        .health-item.red {
            border-left-color: var(--danger);
            background: #fef2f2;
        }

        .health-indicator {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .health-item.green .health-indicator {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .health-item.yellow .health-indicator {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning);
        }

        .health-item.red .health-indicator {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }

        .health-info h4 {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .health-info p {
            font-size: 12px;
            color: var(--text-secondary);
        }

        /* ===== CHARTS GRID ===== */
        .grid-charts {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .chart-box {
            background: var(--card-bg);
            padding: 28px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            position: relative;
        }

        .chart-box h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-primary);
        }

        .chart-container {
            position: relative;
            height: 350px;
            width: 100%;
        }

        .chart-full {
            grid-column: 1 / -1;
        }

        .chart-full .chart-container {
            height: 400px;
        }

        /* ===== TABLES ===== */
        .tables-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .table-box {
            background: var(--card-bg);
            padding: 28px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
        }

        .table-box h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-primary);
        }

        .table-wrapper {
            overflow-x: auto;
            max-height: 400px;
            overflow-y: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        thead {
            background: #f8fafc;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        th {
            padding: 14px;
            text-align: left;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--border);
        }

        td {
            padding: 14px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        /* ===== BADGES ===== */
        .badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-success {
            background: #ecfdf5;
            color: #059669;
        }

        .badge-danger {
            background: #fef2f2;
            color: #dc2626;
        }

        .badge-warning {
            background: #fffbeb;
            color: #d97706;
        }

        .badge-info {
            background: #ecf0ff;
            color: #2563eb;
        }

        /* ===== PRIORITY SECTION ===== */
        .priority-section {
            background: var(--card-bg);
            padding: 28px;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            margin-bottom: 40px;
            border-top: 4px solid var(--danger);
        }

        .priority-section h2 {
            font-family: 'Poppins', sans-serif;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-primary);
        }

        .priority-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 16px;
        }

        .priority-item {
            padding: 16px;
            border-left: 4px solid var(--danger);
            background: #fef2f2;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: start;
        }

        .priority-item.medium {
            border-left-color: var(--warning);
            background: #fffbeb;
        }

        .priority-item.low {
            border-left-color: var(--success);
            background: #ecfdf5;
        }

        .priority-info h4 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .priority-info p {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .priority-amount {
            font-size: 16px;
            font-weight: 800;
            color: var(--text-primary);
            text-align: right;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 1024px) {
            .grid-kpis {
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            }

            .grid-charts {
                grid-template-columns: 1fr;
            }

            .chart-full {
                grid-column: 1;
            }

            .tables-section {
                grid-template-columns: 1fr;
            }

            .header {
                flex-direction: column;
                text-align: center;
                gap: 20px;
            }

            .header-controls {
                justify-content: center;
                flex-wrap: wrap;
            }
        }

        @media (max-width: 640px) {
            body {
                padding: 20px 10px;
            }

            .header {
                padding: 24px;
            }

            .header h1 {
                font-size: 24px;
            }

            .kpi-value {
                font-size: 22px;
            }

            .grid-kpis {
                grid-template-columns: 1fr;
            }

            .priority-item {
                flex-direction: column;
                gap: 12px;
            }

            .priority-amount {
                text-align: left;
            }
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-secondary);
        }

        .empty-state i {
            font-size: 48px;
            opacity: 0.3;
            margin-bottom: 16px;
            display: block;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- HEADER -->
    <div class="header">
        <div class="header-content">
            <span class="header-tag">Executive Dashboard</span>
            <h1>Gestão Financeira Mobcall</h1>
            <p>Visão integrada de caixa, pagamentos e decisões estratégicas</p>
        </div>
        <div class="header-controls">
            <select id="filtroMes" class="select-period" onchange="aplicarFiltro()">
                <option value="todos">Período Total</option>
            </select>
            <button class="btn-refresh" onclick="atualizarDados()">
                <i class="fa-solid fa-rotate-right"></i> Atualizar
            </button>
            <div class="timestamp">
                <i class="fa-solid fa-clock"></i>
                <span id="lastUpdate">Carregando...</span>
            </div>
        </div>
    </div>

    <!-- KPIs PRINCIPAIS -->
    <div class="grid-kpis">
        <div class="kpi-card success">
            <i class="fa-solid fa-arrow-trend-up kpi-icon"></i>
            <span class="kpi-label">Receitas Realizadas</span>
            <strong class="kpi-value" id="kpiRec">R$ 0,00</strong>
            <span class="kpi-change">Período selecionado</span>
        </div>

        <div class="kpi-card danger">
            <i class="fa-solid fa-arrow-trend-down kpi-icon"></i>
            <span class="kpi-label">Despesas Realizadas</span>
            <strong class="kpi-value" id="kpiDes">R$ 0,00</strong>
            <span class="kpi-change">Período selecionado</span>
        </div>

        <div class="kpi-card success">
            <i class="fa-solid fa-hand-holding-dollar kpi-icon"></i>
            <span class="kpi-label">Saldo Positivo</span>
            <strong class="kpi-value" id="kpiSaldo">R$ 0,00</strong>
            <span class="kpi-change">Receitas - Despesas</span>
        </div>

        <div class="kpi-card warning">
            <i class="fa-solid fa-hourglass-end kpi-icon"></i>
            <span class="kpi-label">Pendências Totais</span>
            <strong class="kpi-value" id="kpiPend">R$ 0,00</strong>
            <span class="kpi-change">Aguardando pagamento</span>
        </div>

        <div class="kpi-card info">
            <i class="fa-solid fa-chart-line kpi-icon"></i>
            <span class="kpi-label">Desvio Real vs Decisão</span>
            <strong class="kpi-value" id="kpiDesvio">0%</strong>
            <span class="kpi-change" id="kpiDesvioTipo">Análise de impacto</span>
        </div>
    </div>

    <!-- INDICADOR DE SAÚDE FINANCEIRA -->
    <div class="health-section">
        <h2 class="health-title">
            <i class="fa-solid fa-heart-pulse"></i> Saúde Financeira
        </h2>
        <div class="health-grid">
            <div class="health-item green">
                <div class="health-indicator">
                    <i class="fa-solid fa-check"></i>
                </div>
                <div class="health-info">
                    <h4>Fluxo Positivo</h4>
                    <p id="healthPositivo">Receitas > Despesas</p>
                </div>
            </div>

            <div class="health-item yellow" id="healthPendencias">
                <div class="health-indicator">
                    <i class="fa-solid fa-exclamation"></i>
                </div>
                <div class="health-info">
                    <h4>Pendências Ativas</h4>
                    <p id="healthPendenciasText">Acompanhe os pagamentos em aberto</p>
                </div>
            </div>

            <div class="health-item green" id="healthDecisoes">
                <div class="health-indicator">
                    <i class="fa-solid fa-lightbulb"></i>
                </div>
                <div class="health-info">
                    <h4>Decisões Alinhadas</h4>
                    <p id="healthDecisoesText">Realidade próxima ao planejado</p>
                </div>
            </div>
        </div>
    </div>

    <!-- PRIORIDADES DE PAGAMENTO -->
    <div class="priority-section">
        <h2>
            <i class="fa-solid fa-triangle-exclamation"></i> Prioridades de Pagamento
        </h2>
        <div class="priority-list" id="priorityList">
            <div class="empty-state">
                <i class="fa-solid fa-inbox"></i>
                <p>Nenhuma pendência no momento</p>
            </div>
        </div>
    </div>

    <!-- GRÁFICOS -->
    <div class="grid-charts">
        <div class="chart-box">
            <h2><i class="fa-solid fa-chart-pie"></i> Despesas por Centro de Custo</h2>
            <div class="chart-container">
                <canvas id="chartPizza"></canvas>
            </div>
        </div>

        <div class="chart-box">
            <h2><i class="fa-solid fa-chart-bar"></i> Fluxo de Caixa Previsto</h2>
            <div class="chart-container">
                <canvas id="chartMov"></canvas>
            </div>
        </div>

        <div class="chart-box chart-full">
            <h2><i class="fa-solid fa-chart-line"></i> Comparativo: Fluxo Real vs. Decisões Tomadas</h2>
            <div class="chart-container">
                <canvas id="chartEvol"></canvas>
            </div>
        </div>
    </div>

    <!-- TABELAS -->
    <div class="tables-section">
        <div class="table-box">
            <h2>
                <i class="fa-solid fa-circle-exclamation" style="color: var(--warning)"></i> 
                Carteira de Pendências
            </h2>
            <div class="table-wrapper">
                <table id="tabelaPendentes">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Descrição</th>
                            <th>Categoria</th>
                            <th>Tipo</th>
                            <th>Valor</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="table-box">
            <h2>
                <i class="fa-solid fa-lightbulb" style="color: var(--info)"></i> 
                Observações das Decisões
            </h2>
            <div class="table-wrapper">
                <table id="tabelaObservacoes">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Observação</th>
                            <th>Saldo Previsto</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // ===== CONFIGURAÇÃO =====
    const SHEET_ID = "1LOjJ-8uTY1Vs61C52cgT84oCVmGXe7Hv-Hhf0YEqyIY";

    // URLs de exportação CSV do Google Sheets
    const LINK_LANCAMENTOS = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&sheet=Lançamentos`;
    const LINK_FLUXO = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&sheet=Fluxo Caixa`;
    const LINK_DECISOES = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:csv&sheet=Fluxo Decisões`;

    let dadosBrutos = { lanc: [], fluxo: [], decisoes: [] };
    let charts = {};

    // ===== FUNÇÕES UTILITÁRIAS =====
    function formatarDataBR(s) {
        if (!s) return null;
        let p = s.toString().split('/');
        return p.length === 3 ? new Date(p[2], p[1]-1, p[0]) : null;
    }

    function num(v) {
        if (!v || v === "-" || v === "") return 0;
        if (typeof v === 'number') return v;
        try {
            let s = v.toString().replace("R$", "").trim();
            if (s.includes(",") && s.includes(".")) {
                s = s.replace(/\./g, "").replace(",", ".");
            } else if (s.includes(",")) {
                s = s.replace(",", ".");
            }
            let resultado = parseFloat(s) || 0;
            return isNaN(resultado) ? 0 : resultado;
        } catch(e) {
            console.warn("Erro ao converter número:", v);
            return 0;
        }
    }

    function real(v) {
        return v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    function normalizarColunas(dados) {
        if (!dados || dados.length === 0) return [];
        return dados.map(row => {
            let nRow = {};
            Object.keys(row).forEach(k => {
                if (k) {
                    let clean = k.toLowerCase().trim()
                        .normalize("NFD")
                        .replace(/[\u0300-\u036f]/g, "")
                        .replace(/\s+/g, '_');
                    nRow[clean] = row[k];
                }
            });
            return nRow;
        });
    }

    function atualizarTimestamp() {
        const agora = new Date();
        const hora = agora.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        const data = agora.toLocaleDateString('pt-BR');
        document.getElementById('lastUpdate').innerText = `${data} às ${hora}`;
    }

